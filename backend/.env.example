# ==========================================
# Sahaara AI Backend Environment Variables
# ==========================================

# OpenAI API Key (Required for AI responses)
# Local: Replace with your actual secret key (e.g. sk-proj-...)
# Render: Add or update this in Render Dashboard -> chatbot-backend -> Environment
OPENAI_API_KEY=your_openai_api_key_here

# Server Port (Optional, defaults to 5000)
PORT=5000
