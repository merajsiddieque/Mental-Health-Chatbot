# ==========================================
# Mental Health Chatbot Backend Environment Variables
# ==========================================

# Google Gemini API Key (Required for AI responses)
# Get a free key at: https://aistudio.google.com/app/apikey
# Local: Replace with your actual key
# Render: Add or update this in Render Dashboard -> chatbot-backend -> Environment
GOOGLE_API_KEY=your_google_api_key_here

# Server Port (Optional, defaults to 5000)
PORT=5000
